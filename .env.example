REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL overrides REDIS_HOST and REDIS_PORT when set.
REDIS_URL=
REDIS_CONNECT_RETRIES=30
REDIS_CONNECT_RETRY_DELAY=2s
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=replace-with-a-long-random-secret
SCAN_CRON=*/15 * * * *
APP_ENV=production
BACKEND_PORT=8080
INSTAGRAM_PROVIDER=browser_public
INSTAGRAM_BROWSER_HEADLESS=false
INSTAGRAM_BROWSER_PROFILE_DIR=$HOME/.config/sosyalmedyatakip/chromium-profile
INSTAGRAM_MIN_SYNC_INTERVAL_SECONDS=900
INSTAGRAM_RATE_LIMIT_COOLDOWN_SECONDS=1800
INSTAGRAM_MAX_INITIAL_POSTS=20
INSTAGRAM_MAX_UPDATE_POSTS=10
INSTAGRAM_SCRAPER_URL=http://127.0.0.1:8091
INSTAGRAM_SCRAPER_TIMEOUT=10m
REDIS_ADDR=127.0.0.1:6379
PORT=8080
INSTAGRAM_SYNC_CRON=*/30 * * * *
