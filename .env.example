REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL overrides REDIS_HOST and REDIS_PORT when set.
REDIS_URL=
REDIS_CONNECT_RETRIES=30
REDIS_CONNECT_RETRY_DELAY=2s
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=replace-with-a-long-random-secret
SCAN_CRON=*/15 * * * *
APP_ENV=production
BACKEND_PORT=8080
INSTAGRAM_PROVIDER=
INSTAGRAM_PROVIDER_API_KEY=
INSTAGRAM_PROVIDER_BASE_URL=
INSTAGRAM_PROVIDER_TIMEOUT=20s
INSTAGRAM_PROVIDER_MIN_INTERVAL=250ms
INSTAGRAM_SYNC_CRON=*/30 * * * *
